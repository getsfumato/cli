                  "name": "three.core.min.js",
                  "url": "https://cdn.jsdelivr.net/npm/three@0.184.0/build/three.core.min.js",
                  "sha256": "6486aa0d719cfa87ec88dc47223b59b1fb8417a1a407fc0e52467c943e2f8cc9"
                }
              }
            ]
          },
