            "kind": "esm_namespace",
            "entry": {
              "name": "three.module.min.js",
              "url": "https://cdn.jsdelivr.net/npm/three@0.184.0/build/three.module.min.js",
              "sha256": "36a60b0120335f89a80a0dab70292292b0ec414b3d05e83cd09a3ea428c6712a"
            },
            "imports": [
              {
                "specifier": "./three.core.min.js",
