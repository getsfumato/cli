              "sha256": "f776953f07d3086635fd33953bcde47ba66fedaeb9a7cbc6ece2d4cb03cc56f8"
            }
          ],
          "dependencies": [
            "react-dom"
          ]
        }
      ]
    },
    {
      "id": "motion",
      "name": "Motion",
      "description": "Offline browser animation primitives.",
      "category": "utility",
      "latest_version": "12.42.2",
      "releases": [
        {
          "version": "12.42.2",
          "api_global": "window.SfumatoPlugins.motion",
          "guidance": "Use `window.SfumatoPlugins.motion` for Motion's browser API, including `animate`, `scroll`, `stagger`, and `inView`. Respect reduced-motion preferences and keep content readable before JavaScript runs.",
          "install": {
            "kind": "classic_global",
            "runtime": {
              "name": "motion.js",
              "url": "https://cdn.jsdelivr.net/npm/motion@12.42.2/dist/motion.js",
              "sha256": "3a87f9a05922df2b36582155001fd8e9da3ab5edee10cd07112571cb2d9c94a5"
            },
            "source_global": "window.Motion"
          },
