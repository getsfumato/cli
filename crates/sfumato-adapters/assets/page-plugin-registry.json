      "latest_version": "0.184.0",
      "releases": [
        {
          "version": "0.184.0",
          "api_global": "window.SfumatoPlugins.threejs",
          "guidance": "Three.js is loaded as an ES-module promise. Start generated JavaScript inside an async function with `const THREE = await window.SfumatoPlugins.threejs;`. Create responsive canvases, cap device pixel ratio at 2, and dispose animation frames and WebGL resources.",
