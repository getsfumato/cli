{
  "schema_version": 2,
  "plugins": [
    {
      "id": "lottie",
      "name": "Lottie Web",
      "description": "Offline vector animations from inline Lottie data.",
      "category": "utility",
      "latest_version": "5.13.0",
      "releases": [
        {
          "version": "5.13.0",
          "api_global": "window.SfumatoPlugins.lottie",
          "guidance": "Use `window.SfumatoPlugins.lottie` for lottie-web. Keep animation data inline and pass it through `animationData`; never reference a remote JSON path. Provide an accessible static explanation beside every animation.",
          "install": {
            "kind": "classic_global",
            "runtime": {
              "name": "lottie.min.js",
              "url": "https://cdn.jsdelivr.net/npm/lottie-web@5.13.0/build/player/lottie.min.js",
              "sha256": "2eb762973aec914d981f426123040bfac9d26217239605e225ddc7cee17618ac"
            },
            "source_global": "window.lottie"
          },
          "licenses": [
            {
              "name": "Lottie LICENSE",
              "url": "https://cdn.jsdelivr.net/npm/lottie-web@5.13.0/LICENSE.md",
              "sha256": "9d8d4d8b4bb99572ee8b51025a30b8493d949798cac465c6c15b1b29420bcb06"
            }
          ],
          "dependencies": []
        }
      ]
    },
    {
      "id": "materialui",
      "name": "Material UI",
      "description": "Offline React components using Material UI.",
      "category": "ui",
      "latest_version": "5.15.14",
      "releases": [
        {
          "version": "5.15.14",
          "api_global": "window.MaterialUI",
          "guidance": "Material UI is available as `window.MaterialUI`; React and ReactDOM are installed first. Use `React.createElement`, never JSX or imports. Mount into `#sfumato-react-root` with `ReactDOM.createRoot`, and derive the Material UI theme from the Sfumato theme tokens.",
          "install": {
            "kind": "classic_global",
            "runtime": {
              "name": "material-ui.production.min.js",
              "url": "https://cdn.jsdelivr.net/npm/@mui/material@5.15.14/umd/material-ui.production.min.js",
              "sha256": "57ea6921e62da4fe6aad1b50241d72700ae95f611f9e6932ee9d11a5f45e6df0"
            },
            "source_global": "window.MaterialUI"
          },
          "licenses": [
            {
              "name": "Material UI LICENSE",
