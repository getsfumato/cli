        {
          "version": "0.7.2",
          "api_global": "window.SfumatoPlugins.theatre",
          "guidance": "Theatre.js Core is loaded as an ES-module promise. Start generated JavaScript with `const theatre = (await window.SfumatoPlugins.theatre).default;` inside an async function. Studio is not installed. Keep project state inline.",
          "install": {
            "kind": "esm_namespace",
            "entry": {
              "name": "core.bundle.mjs",
              "url": "https://esm.sh/@theatre/core@0.7.2/es2022/core.bundle.mjs",
              "sha256": "03db221c817a2694b0caed1e291f86602282618b964dcb32b2e427e4adf8c611"
