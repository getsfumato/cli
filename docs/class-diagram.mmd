classDiagram
    direction LR

    namespace Presentation {
        class Commands {
            <<enum>>
            Init
            Config
            Project
            Connector
            Model
            Theme
            Prompt
            Generate
            Edit
        }
        class RunnableCommand {
            <<trait>>
            +run() Result
        }
        class TuiApp {
            -Screen screen
            -JobId activeJob
            -CancellationToken cancellation
            -JoinHandle activeTask
            +handleKey(KeyEvent)
            +draw(Frame)
        }
    }

    namespace Domain {
        class ProjectName
        class ModelProfileName
        class ThemeName
        class SecretRef
        class Capability {
            <<enum>>
            Text
            Code
            Image
            Video
            Speech
            Embedding
        }
        class ReviewableDocument {
            <<trait>>
            +snapshot() ReviewSnapshot
            +applyPatch(Patch) PatchReport
            +validate()
            +render() String
        }
        class DeckDocument
        class Patch
        class ArtifactManifest
        class JobId
        class RevisionId
    }

    namespace Core {
        class GenerateSlidesOptions
        class EditSlidesOptions
        class AgentRunner
        class TextModel {
            <<trait>>
            +complete(TextModelRequest) TextModelResponse
        }
        class ProviderFactory {
            <<trait>>
            +text(EffectiveConfig, ModelProfile)
            +image(EffectiveConfig, ModelProfile)
        }
        class PromptCatalog {
            <<trait>>
            +render(PromptRenderRequest) RenderedPrompt
            +validate() PromptProvenance[]
        }
        class ArtifactStore {
            <<trait>>
            +projectRoot(project) PathBuf
            +begin(project, kind) ArtifactTransaction
        }
        class ArtifactTransaction {
            <<trait>>
            +stagingRoot() Path
            +commit(ResourceArtifactManifest) CommittedRevision
        }
        class ToolExecutor {
            <<trait>>
            +execute(ToolExecutionRequest) String
        }
        class GlobalConfigRepository {
            <<trait>>
        }
        class ProjectRepository {
            <<trait>>
        }
        class ThemeRepository {
            <<trait>>
        }
        class GenerationOutput
        class PromptProvenance
    }

    namespace Adapters {
        class OpenAiCompatibleProviderFactory
        class OpenAiCompatibleTextProvider
        class OpenAiCompatibleImageProvider
        class LayeredPromptCatalog
        class FilesystemArtifactStore
    }

    Commands ..|> RunnableCommand
    TuiApp --> GenerateSlidesOptions
    TuiApp --> EditSlidesOptions

    DeckDocument ..|> ReviewableDocument
    ReviewableDocument --> Patch
    ArtifactManifest --> JobId
    ArtifactManifest --> RevisionId

    GenerateSlidesOptions --> ProviderFactory
    GenerateSlidesOptions --> PromptCatalog
    GenerateSlidesOptions --> ArtifactStore
    GenerateSlidesOptions --> GenerationOutput
    EditSlidesOptions --> ReviewableDocument
    EditSlidesOptions --> ProviderFactory
    EditSlidesOptions --> PromptCatalog
    EditSlidesOptions --> ArtifactStore
    AgentRunner --> TextModel
    AgentRunner --> ToolExecutor
    PromptCatalog --> PromptProvenance
    ArtifactStore --> ArtifactTransaction

    OpenAiCompatibleProviderFactory ..|> ProviderFactory
    OpenAiCompatibleProviderFactory --> OpenAiCompatibleTextProvider
    OpenAiCompatibleProviderFactory --> OpenAiCompatibleImageProvider
    OpenAiCompatibleTextProvider ..|> TextModel
    LayeredPromptCatalog ..|> PromptCatalog
    FilesystemArtifactStore ..|> ArtifactStore
