%% Public and composition-relevant Rust types in Sfumato v0.2.
classDiagram
    direction LR

    namespace Presentation {
        class Commands {
            <<enum>>
            Init
            Config
            Project
            Connector
            Model
            Theme
            Template
            Artifact
            Prompt
            Plugin
            Tool
            Renderer
            Generate
            Edit
        }
        class RunnableCommand {
            <<trait>>
            +run() Result
        }
        class App {
            -screen
            -application
            -jobs
            -active_task
        }
        class OperationLifecycle {
            +begin(events) OperationContext
            +cancel()
            +finish(job_id)
        }
    }

    namespace Domain {
        class DeckDocument
        class PageDocument
        class VideoPlanDocument
        class VideoSourceDocument
        class VideoEngine
        class ReviewableDocument {
            <<trait>>
            +snapshot() ReviewSnapshot
            +apply_patch(patch) PatchReport
            +validate()
            +render() String
        }
        class Capability
        class SecretRef
        class ArtifactManifest
        class RevisionId
    }

    namespace Core {
        class SfumatoApplication {
            +generate_slides(command) GenerateSlidesResult
            +generate_page(command) GeneratePageResult
            +generate_video(command) GenerateVideoResult
            +edit_slides(command) EditSlidesResult
            +list_projects()
            +list_models()
            +list_themes()
            +list_templates()
            +list_project_assets()
            +list_prompts()
        }
        class SfumatoApplicationDependencies
        class GenerateSlidesCommand
        class GeneratePageCommand
        class GenerateVideoCommand
        class EditSlidesCommand
        class AgentRunner {
            +run(model, request, tools, operation) TextModelResponse
        }
        class TextModel {
            <<trait>>
            +complete(request, operation) TextModelResponse
        }
        class TextGenerationProvider {
            <<trait>>
            +generate(request, operation) TextGenerationResponse
        }
        class ProviderFactory {
            <<trait>>
            +text(config, profile) TextGenerationProvider
            +image(config, profile) ImageGenerationProvider
            +video(config, profile) VideoGenerationProvider
        }
        class ConnectorIntrospection {
            <<trait>>
            +capabilities(connector) ConnectorCapabilities
            +list_models(name, connector, operation) ConnectorModelSummary[]
            +status(name, connector, operation) ConnectorStatus
        }
        class SecretResolver {
            <<trait>>
            +resolve(reference) SecretValue
        }
        class SecretStore {
            <<trait>>
            +save(reference, value)
            +exists(reference) bool
            +delete(reference)
        }
        class EffectiveConfigResolver {
            <<trait>>
            +resolve(overrides) EffectiveConfig
        }
        class PromptCatalog {
            <<trait>>
            +render(request) RenderedPrompt
            +validate_all() PromptProvenance
        }
        class SourceReader {
            <<trait>>
        }
        class GenerationToolFactory {
            <<trait>>
        }
        class DiagramRenderer {
            <<trait>>
        }
        class SlideRenderer {
            <<trait>>
        }
        class PageAssembler {
            <<trait>>
            +assemble(request) AssembledPage
        }
        class AssembledPage {
            +html String
            +runtimes PageRuntimeSelection[]
        }
        class PageInspector {
            <<trait>>
            +inspect(path, browser, operation) PageInspectionIssue
        }
        class VideoGenerationProvider {
            <<trait>>
            +generate_video(request, operation, stage) VideoGenerationResponse
        }
        class VideoRenderer {
            <<trait>>
            +render(engine, request, operation)
            +inspect(path, operation) VideoInspection
        }
        class RendererManager {
            <<trait>>
            +list(operation) RendererStatus[]
            +install(id, operation) RendererStatus
            +remove(id) RendererStatus
            +doctor(id, operation) RendererStatus[]
        }
        class PagePluginCatalog {
            <<trait>>
            +list() PagePluginSummary
            +load(id) PagePluginPackage
            +install(package) PagePluginPackage
        }
        class PagePluginSource {
            <<trait>>
            +registry(operation) PagePluginRegistry
            +download(plugin, release, operation) DownloadedPagePluginPackage
        }
        class GenerationTemplateCatalog {
            <<trait>>
            +list(kind) GenerationTemplateSummary
            +load(name, kind) GenerationTemplate
            +create(name, kind, source) GenerationTemplate
        }
        class ProjectAssetCatalog {
            <<trait>>
            +list(project_root) ProjectAsset
            +add(project_root, source, name, description) ProjectAsset
            +remove(project_root, name) ProjectAsset
        }
        class ArtifactStore {
            <<trait>>
            +project_root(project) PathBuf
            +begin(project, kind) ArtifactTransaction
        }
        class ArtifactTransaction {
            <<trait>>
            +staging_root() Path
            +commit(manifest) CommittedArtifactRevision
        }
        class GlobalConfigRepository {
            <<trait>>
        }
        class ProjectRepository {
            <<trait>>
        }
        class ThemeRepository {
            <<trait>>
        }
        class WorkspaceFileSystem {
            <<trait>>
        }
        class SfumatoError
        class OperationContext
    }

    namespace Adapters {
        class FilesystemConfigResolver
        class LayeredPromptCatalog
        class OpenAiCompatibleProviderFactory
        class AdapterProviderFactory
        class OpenAiCompatibleTextProvider
        class OpenAiCompatibleImageProvider
        class OpenRouterConnector {
            -transport: OpenAiCompatibleConnector
            +list_models(operation) ConnectorModelSummary[]
            +status(operation) ConnectorStatus
        }
        class OllamaConnector {
            -native_base_url
            +list_models(operation) ConnectorModelSummary[]
            +status(operation) ConnectorStatus
        }
        class CodexAppServerProvider {
            -process
            -cached_models
            +generate(request, operation) TextGenerationResponse
            +discover_models(config, operation) ConnectorModelSummary[]
        }
        class FilesystemSourceReader
        class FilesystemGenerationToolFactory
        class MermaidCliRenderer
        class MarpCliRenderer
        class StandalonePageAssembler
        class ChromiumPageInspector
        class OpenRouterVideoProvider
        class ManagedVideoRenderers
        class FilesystemPagePluginCatalog
        class CdnPagePluginSource
        class SystemSecretStore
        class FilesystemGenerationTemplateCatalog
        class FilesystemProjectAssetCatalog
        class FilesystemArtifactStore
        class FilesystemGlobalConfigRepository
        class FilesystemProjectRepository
        class FilesystemThemeRepository
        class LocalWorkspaceFileSystem
    }

    Commands ..|> RunnableCommand
    App --> OperationLifecycle
    App --> SfumatoApplication

    DeckDocument ..|> ReviewableDocument
    PageDocument ..|> ReviewableDocument
    VideoPlanDocument ..|> ReviewableDocument
    VideoSourceDocument ..|> ReviewableDocument
    VideoPlanDocument --> VideoEngine
    VideoSourceDocument --> VideoEngine
    ArtifactManifest --> RevisionId
    SfumatoApplication *-- SfumatoApplicationDependencies
    SfumatoApplication --> GenerateSlidesCommand
    SfumatoApplication --> GeneratePageCommand
    SfumatoApplication --> GenerateVideoCommand
    SfumatoApplication --> EditSlidesCommand
    SfumatoApplication --> AgentRunner
    SfumatoApplication --> ProviderFactory
    SfumatoApplication --> ConnectorIntrospection
    SfumatoApplication --> SecretStore
    SfumatoApplication --> EffectiveConfigResolver
    SfumatoApplication --> PromptCatalog
    SfumatoApplication --> SourceReader
    SfumatoApplication --> GenerationToolFactory
    SfumatoApplication --> DiagramRenderer
    SfumatoApplication --> SlideRenderer
    SfumatoApplication --> PageAssembler
    PageAssembler --> AssembledPage
    SfumatoApplication --> PageInspector
    SfumatoApplication --> VideoRenderer
    SfumatoApplication --> RendererManager
    SfumatoApplication --> PagePluginCatalog
    SfumatoApplication --> PagePluginSource
    SfumatoApplication --> GenerationTemplateCatalog
    SfumatoApplication --> ProjectAssetCatalog
    SfumatoApplication --> ArtifactStore
    SfumatoApplication --> GlobalConfigRepository
    SfumatoApplication --> ProjectRepository
    SfumatoApplication --> ThemeRepository
    SfumatoApplication --> WorkspaceFileSystem
    SfumatoApplication --> SfumatoError
    GenerateSlidesCommand --> OperationContext
    GeneratePageCommand --> OperationContext
    GenerateVideoCommand --> OperationContext
    EditSlidesCommand --> OperationContext
    AgentRunner ..|> TextGenerationProvider
    AgentRunner --> TextModel
    ArtifactStore --> ArtifactTransaction

    FilesystemConfigResolver ..|> EffectiveConfigResolver
    LayeredPromptCatalog ..|> PromptCatalog
    OpenAiCompatibleProviderFactory ..|> ProviderFactory
    AdapterProviderFactory ..|> ProviderFactory
    AdapterProviderFactory ..|> ConnectorIntrospection
    AdapterProviderFactory --> OpenRouterConnector
    AdapterProviderFactory --> OllamaConnector
    OpenAiCompatibleProviderFactory --> OpenAiCompatibleTextProvider
    OpenAiCompatibleProviderFactory --> OpenAiCompatibleImageProvider
    OpenAiCompatibleTextProvider ..|> TextModel
    CodexAppServerProvider ..|> TextGenerationProvider
    FilesystemSourceReader ..|> SourceReader
    FilesystemGenerationToolFactory ..|> GenerationToolFactory
    MermaidCliRenderer ..|> DiagramRenderer
    MarpCliRenderer ..|> SlideRenderer
    StandalonePageAssembler ..|> PageAssembler
    ChromiumPageInspector ..|> PageInspector
    OpenRouterVideoProvider ..|> VideoGenerationProvider
    ManagedVideoRenderers ..|> VideoRenderer
    ManagedVideoRenderers ..|> RendererManager
    FilesystemPagePluginCatalog ..|> PagePluginCatalog
    CdnPagePluginSource ..|> PagePluginSource
    SecretStore --|> SecretResolver
    SystemSecretStore ..|> SecretStore
    OpenAiCompatibleProviderFactory --> SecretResolver
    FilesystemGenerationTemplateCatalog ..|> GenerationTemplateCatalog
    FilesystemProjectAssetCatalog ..|> ProjectAssetCatalog
    FilesystemArtifactStore ..|> ArtifactStore
    FilesystemGlobalConfigRepository ..|> GlobalConfigRepository
    FilesystemProjectRepository ..|> ProjectRepository
    FilesystemThemeRepository ..|> ThemeRepository
    LocalWorkspaceFileSystem ..|> WorkspaceFileSystem
