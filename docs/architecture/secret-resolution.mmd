%% Secure credential management and request-time resolution.
flowchart LR
    subgraph Presentation["CLI or future frontend"]
        LOGIN["connector login"]
        GENERATE["generate resource"]
    end

    subgraph Core["sfumato-core"]
        APP["SfumatoApplication"]
        CONNECTOR["ConnectorService"]
        STORE["SecretStore port"]
        RESOLVER["SecretResolver port"]
        PROVIDER["ProviderFactory and connector transport"]
    end

    subgraph LocalAdapter["CLI infrastructure"]
        SYSTEM["SystemSecretStore"]
        KEYRING["Native OS keyring"]
        ENV["Environment fallback"]
    end

    subgraph FutureAdapter["Future web infrastructure"]
        CLOUD["Tenant-scoped CloudSecretStore"]
        VAULT["KMS, Vault, or encrypted database"]
    end

    LOGIN --> APP --> CONNECTOR --> STORE
    STORE -. implemented locally .-> SYSTEM
    SYSTEM --> KEYRING

    GENERATE --> APP --> PROVIDER --> RESOLVER
    RESOLVER -. implemented locally .-> SYSTEM
    SYSTEM --> ENV

    STORE -. implemented by web server .-> CLOUD
    RESOLVER -. implemented by web server .-> CLOUD
    CLOUD --> VAULT
