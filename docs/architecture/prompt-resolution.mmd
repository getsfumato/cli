%% Implemented strict prompt resolution and provenance flow.
flowchart TD
    STAGE["Workflow stage and retry mode"] --> PAIR["PromptPair with stable system and user PromptId values"]
    PAIR --> MANIFEST["Versioned bundled manifest: relative path and required variables"]
    MANIFEST --> PROJECT{"Project override exists?"}
    PROJECT -- yes --> PROJECT_SOURCE["Select project template"]
    PROJECT -- no --> USER{"User override exists?"}
    USER -- yes --> USER_SOURCE["Select user template"]
    USER -- no --> BUNDLED_SOURCE["Select bundled template"]

    VARIABLES["Typed context: instruction, SFUMATO.md, sources, theme, snapshots, errors, and layout issues"] --> REQUIRED{"All required variables supplied?"}
    REQUIRED -- no --> ERROR["PromptError before provider invocation"]
    REQUIRED -- yes --> COMPILE
    PROJECT_SOURCE --> COMPILE["Compile MiniJinja with strict undefined values"]
    USER_SOURCE --> COMPILE
    BUNDLED_SOURCE --> COMPILE
    COMPILE --> SAFE{"Contained relative paths, no symlinks, valid includes, and size limit?"}
    SAFE -- no --> ERROR
    SAFE -- yes --> RENDER["RenderedPrompt"]
    RENDER --> TEXT["System or user message text"]
    RENDER --> PROVENANCE["PromptId, origin, manifest version, and SHA-256 source hash"]
    TEXT --> PROVIDER["Text or image provider port"]
    PROVENANCE --> RESULT["Generation result and immutable revision manifest"]
