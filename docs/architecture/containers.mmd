%% Sfumato v0.2 architecture and remaining boundaries
%% Legend: green = implemented; amber = transitional; blue = remaining target.
flowchart TB
    subgraph Clients["Presentation clients"]
        CLI["CLI commands\nImplemented"]
        TUI["Ratatui workspace\nImplemented"]
        LIB["Stable SfumatoApplication facade\nRemaining"]
    end

    subgraph Composition["sfumato crate: presentation and composition"]
        BOOT["CLI composition root\nImplemented, direct wiring"]
    end

    subgraph Application["sfumato-core crate: application and ports"]
        GEN["GenerateSlides workflow\nImplemented"]
        EDIT["EditSlides workflow\nImplemented"]
        CFG["Configuration workflows\nTransitional filesystem coupling"]
        PROMPT["PromptCatalog port and DTOs\nImplemented"]
        TX["ArtifactStore transaction port\nImplemented"]
    end

    subgraph Domain["sfumato-domain crate"]
        DECK["DeckDocument and review rules\nImplemented"]
        MODEL["Validated IDs, capabilities,\nand artifact manifests\nImplemented"]
        ERROR["Typed errors and operation context\nImplemented, adoption transitional"]
    end

    subgraph Ports["Outbound ports in sfumato-core"]
        PROVIDERS["Text and image provider traits\nImplemented"]
        REPOS["Config, project and theme repositories\nTransitional concrete implementations"]
        RENDER["Renderer and layout inspector ports\nRemaining extraction"]
        STORE["ArtifactStore port\nImplemented"]
        EVENTS["EventSink and operation cancellation\nImplemented, adoption transitional"]
    end

    subgraph Adapters["sfumato-adapters crate"]
        OPENAI["OpenAI-compatible HTTP\nImplemented"]
        FS["Filesystem artifact and prompt adapters\nImplemented"]
        MARP["Marp and browser processes\nImplemented"]
        MERMAID["Mermaid process\nImplemented"]
        TERMINAL["Human and JSON presenters\nImplemented"]
        TEMPLATES["Layered MiniJinja prompt catalog\nImplemented"]
    end

    subgraph External["External systems"]
        API["Model APIs and Ollama"]
        DISK["User config, project roots,\nand artifact workspace"]
        BIN["marp, browser, and mmdc"]
    end

    CLI --> BOOT
    TUI --> BOOT
    LIB --> BOOT
    BOOT --> GEN
    BOOT --> EDIT
    BOOT --> CFG
