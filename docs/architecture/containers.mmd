%% Sfumato v0.2 implemented container architecture.
flowchart TB
    subgraph Presentation["sfumato crate: presentation and composition"]
        CLI["Clap commands and RunnableCommand"]
        TUI["Ratatui model, reducer, effects, and view"]
        OUTPUT["Human and JSON presenters"]
        BOOT["Production composition root"]
    end

    subgraph Core["sfumato-core crate: application policy and ports"]
        APP["SfumatoApplication"]
        GENERATE["Generate slides workflow"]
        EDIT["Edit slides workflow"]
        SERVICES["Project, model, connector, theme, prompt, and config services"]
        AGENT["AgentRunner"]
        PORTS["Repository, provider, secret, prompt, source, tool, renderer, filesystem, and artifact ports"]
        ERRORS["SfumatoError and OperationContext"]
    end

    subgraph Domain["sfumato-domain crate: pure invariants"]
        DECK["DeckDocument and ReviewableDocument"]
        VALUES["Validated names, capabilities, SecretRef, and revisions"]
        MANIFEST["ArtifactManifest and review snapshots"]
    end

    subgraph Adapters["sfumato-adapters crate: infrastructure"]
        CONFIG["Schema-v4 TOML repositories"]
        PROMPTS["Layered MiniJinja PromptCatalog"]
        OPENAI["OpenAI-compatible text and image transport"]
        OPENROUTER["OpenRouter native catalog and usage"]
        OLLAMA["Ollama native catalog and runtime"]
        CODEX["Codex App Server JSON-RPC provider"]
        TOOLS["Filesystem and image-generation tools"]
        RENDERERS["Marp, Mermaid, browser, and layout adapters"]
        ARTIFACTS["FilesystemArtifactStore"]
        SECRETS["SystemSecretStore"]
    end

    subgraph External["External systems"]
        API["Ollama, OpenRouter, and compatible APIs"]
        DISK["Config, project roots, themes, and artifact revisions"]
        PROCESSES["codex, marp, mmdc, and browser processes"]
        KEYRING["macOS Keychain or native OS credential store"]
    end

