%% Schema-v5 read, v4 migration, resolution, and optimistic mutation lifecycle.
flowchart TD
    START["Resolve operation configuration"] --> READ_GLOBAL["Read global config and registry without mutation"]
    READ_GLOBAL --> VERSION{"schema_version"}
    VERSION -->|4| MIGRATE["backup .v4.bak and atomically migrate"]
    MIGRATE --> DTO
    VERSION -->|other| READ_ERROR["Return typed config error and preserve bytes"]
    VERSION -->|5| DTO["Strictly deserialize deny-unknown-fields DTOs"]
    DTO --> SELECT["Select explicit or active project"]
    SELECT --> READ_PROJECT["Read project.toml without mutation"]
    READ_PROJECT --> MERGE["Merge global, project, and command overrides"]
    MERGE --> VALIDATE["Validate connector, model, capability, role, theme, browser, secret, and path references"]
    VALIDATE --> EFFECTIVE["Return immutable EffectiveConfig"]

    MUTATION["Config or service mutation"] --> LOCK["Acquire cross-process file lock"]
    LOCK --> SNAPSHOT["Load typed document and SHA-256 content revision"]
    SNAPSHOT --> SECRET{"Attempts raw secret or unknown field?"}
    SECRET -- yes --> WRITE_ERROR["Reject and preserve original bytes"]
    SECRET -- no --> APPLY["Apply typed change in memory"]
    APPLY --> REVALIDATE["Validate complete document and cross-references"]
    REVALIDATE --> COMPARE{"Persisted revision still matches?"}
    COMPARE -- no --> STALE["Return stale revision error"]
    COMPARE -- yes --> TEMP["Write and sync same-directory temporary file"]
    TEMP --> RENAME["Atomically replace target and sync parent directory"]
    RENAME --> UNLOCK["Release lock"]
