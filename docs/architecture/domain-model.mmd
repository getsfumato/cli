%% Domain entities and application contracts implemented in v0.2.
classDiagram
    class ProjectName
    class ModelProfileName
    class ThemeName
    class JobId
    class ArtifactId
    class RevisionId
    class SecretRef
    class Capability {
        Text
        Code
        Image
        Video
        Speech
        Embedding
    }

    class DeckDocument {
        -title
        -frontmatter
        -order
        -slides
        -revision
        +from_marp(markdown, title)
        +snapshot()
        +apply_patch(patch)
        +replace_slide(position, markdown)
        +render()
    }
    class PageDocument {
        -title
        -body_html
        -css
        -javascript
        -revision
        +snapshot()
        +apply_patch(patch)
        +apply_browser_repair_patch(patch)
        +render()
    }
    class ReviewableDocument {
        <<trait>>
        +snapshot()
        +validate_patch(patch)
        +apply_patch(patch)
        +validate()
        +render()
    }
    class ReviewSnapshot {
        +schema_version
        +format
        +revision
        +document
        +constraints
    }
    class ReviewConstraint {
        Rfc6902Only
        TestDeckRevision
        TestSlideRevision
        PreserveTitleSlide
        PreserveMetadata
        ReplaceSlideMarkdownOnly
    }
    class SlideDocument {
        +revision
        +kind
        +heading
        +markdown
        +elements
    }
    class SlideId
    class SlideElement
    class PatchReport

    class ResourceArtifactManifest {
        +schema_version
        +resource_id
        +project
        +job_id
        +revision_id
        +parent_revision_id
        +files
        +metadata
        +prompts
    }
    class PromptProvenance
    class OperationContext {
        +job_id()
        +checkpoint(stage)
        +emit(stage, kind, fields)
        +remaining()
    }
    class SfumatoError {
        +code
        +class
        +stage
        +message
        +details
    }

    ReviewableDocument <|.. DeckDocument
    ReviewableDocument <|.. PageDocument
    DeckDocument *-- SlideDocument
    DeckDocument *-- SlideId
    SlideDocument *-- SlideElement
    DeckDocument --> ReviewSnapshot
    ReviewSnapshot *-- ReviewConstraint
    DeckDocument --> PatchReport
    ResourceArtifactManifest --> ProjectName
    ResourceArtifactManifest --> JobId
    ResourceArtifactManifest --> RevisionId
    ResourceArtifactManifest *-- PromptProvenance
    OperationContext --> JobId
    OperationContext --> SfumatoError
    ModelProfileName --> Capability
